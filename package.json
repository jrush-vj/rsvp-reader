{
  "name": "booktube",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BookTube — read books one word at a time.",
  "scripts": {
    "dev": "concurrently -k \"python app.py\" \"tauri dev\"",
    "build:frontend": "npm run build --prefix web",
    "build": "npm run backend && tauri build",
    "typecheck": "npm run typecheck --prefix web",
    "tauri": "tauri",
    "backend": "python desktop/build_backend.py"
  },
  "dependencies": {
    "framer-motion": "^11.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "concurrently": "^9.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
